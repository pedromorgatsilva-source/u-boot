bootdelay=30
bootretry=1
stdin=serial,button-kbd,usbkbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
fastboot=fastboot -l $fastboot_addr_r usb 0

# Always probe for UFS and USB storage, though it should be done by board code.
preboot=scsi scan; usb start

# Shortcut to enable USB serial gadget and disable bootretry
serial_gadget=setenv stdin serial,button-kbd,usbkbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

boot_from_mmc_pm=load mmc 2:1 $kernel_addr_r Image; \
	load mmc 2:1 $fdt_addr_r sm7150-motorola-hanoip.dtb; \
	load mmc 2:1 $ramdisk_addr_r initramfs; \
	setenv bootargs "verbose loglevel=2 console=ttyGS0,115200 pmos.nosplash pmos_root_uuid=571ebe8e-d675-4f2e-8492-1cf59473c10f pmos_rootfsopts=defaults"; \
	booti $kernel_addr_r $ramdisk_addr_r:$filesize $fdt_addr_r

boot_from_mmc=load mmc 2:2 $kernel_addr_r boot/vmlinuz-4.14.190-perf+; \
	load mmc 2:1 $fdt_addr_r sdmmagpie-hanoip.dtb; \
	load mmc 2:2 $ramdisk_addr_r boot/initrd.img-4.14.190-perf+; \
	setenv bootargs "root=/dev/mmcblk1p2 rw debug verbose"; \
	booti $kernel_addr_r $ramdisk_addr_r:$filesize $fdt_addr_r

boot_from_mmc2=load mmc 2:2 $kernel_addr_r boot/vmlinuz-4.14.190-perf; \
	load mmc 2:1 $fdt_addr_r sdmmagpie-hanoip.dtb; \
	load mmc 2:2 $ramdisk_addr_r boot/initrd.img-4.14.190-perf; \
	setenv bootargs "root=/dev/mmcblk1p2 rw debug verbose"; \
	booti $kernel_addr_r $ramdisk_addr_r:$filesize $fdt_addr_r

# bootretry will run this command over and over, if we fail once
# then bail out to the boot menu instead (with a pause to read
# the error message)
bootcmd=run menucmd

# When entering the menu (either from button press or failed boot)
# remap bootcmd so it will re-open the menu and we won't get stuck
# at the console with no way to type
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Pause is used so the output can be read on the display
bootmenu_0=Boot pmos=run boot_from_mmc_pm
bootmenu_1=Boot=run boot_from_mmc
bootmenu_2=Boot2=run boot_from_mmc2
bootmenu_3=Enable serial console gadget=run serial_gadget
bootmenu_4=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 mmc 2
bootmenu_5=Enable fastboot mode=run fastboot
# Disabling bootretry means we'll just drop the shell
bootmenu_6=Drop to shell=setenv bootretry -1
bootmenu_7=Reset device=reset
bootmenu_8=Dump clocks=clk dump; pause
bootmenu_9=Dump environment=printenv; pause
bootmenu_10=Board info=bdinfo; pause
bootmenu_11=Dump bootargs=fdt print /chosen bootargs; pause
bootmenu_12=Poweroff=poweroff

# Allow holding the volume down button while U-Boot loads to enter
# the boot menu
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
